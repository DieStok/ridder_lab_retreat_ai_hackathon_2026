# Optional. Defaults to heuristic extraction if no model is reachable.
LAB_ATLAS_AI_MODE=hybrid
LAB_ATLAS_OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Required to use /admin. Pick a real secret locally; do not commit `.env`.
LAB_ATLAS_ADMIN_PASSWORD=
LAB_ATLAS_SESSION_SECRET=

# Optional cloud fallback for non-sensitive demo transcripts only.
# LAB_ATLAS_CLOUD_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
