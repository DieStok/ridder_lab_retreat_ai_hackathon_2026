# roybot — environment template. Copy to .env and fill in.

# --- Local LLM (Ollama) -------------------------------------------------
# Where Ollama is listening. Laptop default is localhost. On the HPC,
# point this at a compute node where you've started `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434
# Override the default model. Anything in `ollama list` works.
# Tested: qwen2.5:14b (default), qwen2.5:7b (faster, dumber), llama3.1:8b.
# On the lab HPC the shared install has e.g. gemma4:26b, qwen3.5:27b, gpt-oss:20b.
OLLAMA_MODEL=qwen2.5:14b
# Context window in tokens. Ollama otherwise falls back to a ~4096 VRAM default
# and silently truncates the prompt. Also settable per-call with --num-ctx.
OLLAMA_NUM_CTX=8192

# --- HPC Ollama (only for scripts/ollama_hpc.sh + run_roboroy.sbatch) ---
# Shared GPU-built Ollama install (binary + model cache). Override only if the
# lab moves it. `serve-local` reads OLLAMA_CONTEXT_LENGTH (export it before the
# call) so the spawned `ollama serve` doesn't truncate at ~4096.
# OLLAMA_INSTALL_DIR=/hpc/compgen/projects/ollama/ollama_run/analysis/dstoker
# OLLAMA_CONTEXT_LENGTH=8192

# --- Auto GPU routing (scripts/submit_roboroy.sh + roybot.gpu_router) ---
# Ollama model store gguf-parser reads to estimate VRAM. Defaults to
# $OLLAMA_INSTALL_DIR/ollama_models; the launcher sets it for you.
# OLLAMA_MODELS=/hpc/compgen/projects/ollama/ollama_run/analysis/dstoker/ollama_models
# Safety multiplier on the raw gguf-parser VRAM estimate before tier selection
# (gguf-parser excludes Ollama's runtime buffer). Default 1.3.
# ROBOROY_VRAM_HEADROOM=1.3

# --- Piper TTS (optional, only needed for --engine piper) --------------
# Path to a Piper .onnx voice model. If unset, roybot looks for ./models/*.onnx
# or whatever you pass with --piper-model.
# PIPER_VOICE_MODEL=models/en_GB-northern_english_male-medium.onnx
